<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="restaurantsListInUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:restaurantsListInUI.Views"
    Title="restaurantsListInUI"
    Padding="10"
    FlyoutBehavior="Locked">


    <ShellContent
         Title="Login Page"
         ContentTemplate="{DataTemplate local:LoginPage}"
         Route="LoginPage" />
    <ShellContent
         Title="Register Page"
         ContentTemplate="{DataTemplate local:RegisterPage}"
         Route="RegisterPage" />
    <ShellContent
     Title="Restaurant"
     ContentTemplate="{DataTemplate local:RestaurantAsListPage}"
     Route="RestaurantAsListPage" />
    <ShellContent
        Title="Resto List"
        ContentTemplate="{DataTemplate local:RestaurantListPage}"
        Route="RestaurantListPage" />


</Shell>
