<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurantsListInUI.Views.RestaurantAsListPage"
             Title="RestaurantAsListPage">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding restaurants}">
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    >
                    <Label FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Text="No restaurants found" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout Padding="5" Spacing="5">
                        <Label Text="{Binding RestName}" VerticalOptions="Center"/>
                        <!--<Label Text="{Binding Kosher}" VerticalOptions="Center"/>-->
                        <Label Text="{Binding CostLevel}" VerticalOptions="Center"/>
                        <Button Clicked="bt_Clicked" Text="kosher?"/>
                        <Image
                            HeightRequest="50"
                            Source="{Binding Image}"
                            WidthRequest="50"/>
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>