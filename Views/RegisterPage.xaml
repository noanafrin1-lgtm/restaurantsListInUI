<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurantsListInUI.Views.RegisterPage"
             Title="RegisterPage">

    <Grid RowDefinitions="*, auto">
        <ScrollView Grid.Row="0" BackgroundColor="{x:StaticResource Gray200}">
            
            <VerticalStackLayout>
                <Label Text="Full Name"
                        FontFamily="NoaFont"
                        FontSize="20"/>
                <Border>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding EntryFullName}" Placeholder="Full Name"/>
                </Border>

                <Label Text="{Binding ErrFullName}"  TextColor="{x:StaticResource Red11}"/>

                <Label Text="Email address: "
                        FontFamily="NoaFont"
                        FontSize="20"/>
                <Border>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding EntryEmail}" Placeholder="Enter your email"/>
                </Border>

                <Label Text="{Binding ErrEmail}" TextColor="{x:StaticResource Red11}"/>

                
               
                
                <Label Text="Password"
                        FontFamily="NoaFont"
                        FontSize="20"/>
                <Border>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding EntryPassword1}" Placeholder="Enter your password"/>
                </Border>
                <Label  Text="{Binding ErrPassword1}" TextColor="{x:StaticResource Red11}"/>
                
                
           
                <Label Text="Confirm Password"
                        FontFamily="NoaFont"
                        FontSize="20"/>
                <Border>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding EntryPassword2}" Placeholder="Confirm Password"/>
                </Border>
                <Label Text="{Binding ErrPassword2}" TextColor="{x:StaticResource Red11}"/>

                
                
                

            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" BackgroundColor="{x:StaticResource Gray500}">
            <Button Command="{Binding GoToLoginCommand}" Text="Go to login"/>
            <Button Command="{Binding RegisterCommand}" Text="Register"/>
        </VerticalStackLayout>
    </Grid>
   
</ContentPage>