<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurantsListInUI.Views.LoginPage"
             Title="LoginPage">
    <Grid RowDefinitions="*, auto">
        <ScrollView Grid.Row="0"  BackgroundColor="{x:StaticResource Gray200}">
            <VerticalStackLayout>
                <Label Text="Email address: "
                       FontFamily="NoaFont"
                       FontSize="20"/>
                <Border>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry x:Name="entryEmail"
                           Placeholder="Enter your email"/>
                </Border>

                <Label x:Name="errEmail"
                       Text=""
                       TextColor="{x:StaticResource Red11}"/>

                <Label Text="Password :"
                        FontFamily="NoaFont"
                        FontSize="20"/>
                <Border>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry x:Name="entryPassword" Placeholder="Enter your password"/>
                </Border>

                <Label x:Name="errPassword"
                       Text=""
                       TextColor="{x:StaticResource Red11}" />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1">
            <Button Clicked="btnSwithPageToRegister" 
                    Text="Go to register"/>
            <Button Clicked="btnLogin"
                    Text="Login"/>
        </VerticalStackLayout>
    </Grid>
    
</ContentPage>