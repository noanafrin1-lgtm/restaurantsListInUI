<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="restaurantsListInUI.Views.LoginPage"
             Title="LoginPage">
    <Grid RowDefinitions="*, auto">
        <ScrollView Grid.Row="0"  BackgroundColor="{x:StaticResource Gray200}">
            <VerticalStackLayout>
                <Label Text="Email address: "
                       FontFamily="NoaFont"
                       FontSize="20"/>
                <Border>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding EntryEmail}"
                           Placeholder="Enter your email"/>
                </Border>

                <Label Text="{Binding ErrEmail}"
                       TextColor="{x:StaticResource Red11}"/>

                <Label Text="Password :"
                        FontFamily="NoaFont"
                        FontSize="20"/>
                <Border>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,50">
                        <Entry Text="{Binding EntryPassword}" Placeholder="Enter your password" IsPassword="{Binding IsHidePassword}"/>
                        <Button Text="VH" Command="{Binding ToggleViewPasswordCommand}" Grid.Column="1"/>
                    </Grid>
                   
                </Border>

                <Label Text="{Binding ErrPassword}"
                       TextColor="{x:StaticResource Red11}" />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1">
            <Button Command="{Binding GoToRegisterCommand}" 
                    Text="Go to register"/>
            <Button Command="{Binding SubmitLoginCommand}"
                    Text="Login"/>
        </VerticalStackLayout>
    </Grid>
    
</ContentPage>